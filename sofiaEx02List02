    if (consumo <= 100) {
        valorConta = consumo * 0.50;
    } else if (consumo <= 200){
    valorConta = consumo * 0.70;
    } else {
        valorConta = consumo * 0.90;
    }
    System.out.printf(" Valor da conta de energia: R$ %.2f%n", valorConta);
}
