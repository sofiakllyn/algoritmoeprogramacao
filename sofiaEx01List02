void main() {
    Scanner input = new Scanner(System.in);

    int idade;

    System.out.print("Qual a sua idade?: ");
    idade = input.nextInt();

    if (idade <= 12){
        System.out.println("infantil");
    } else if (idade >=13 && idade <=17){
        System.out.println("Você é jovem!");
    } else if (idade >= 18){
        System.out.println("Você é adulto!");
    }
}
